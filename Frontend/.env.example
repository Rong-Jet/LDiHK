# Backend API origin used by browser calls (/health, /api/me, /api/query,
# /api/population, /api/imports). Read at BUILD time: on Netlify set it with
# the "Builds" scope and redeploy after changing it.
# Example: https://ldihk-api.onrender.com  (local: http://127.0.0.1:8000)
# Leave empty to use the local Astro mock API routes.
PUBLIC_API_URL=

# Set to true/1/yes/on to force local mock API mode and ignore backend URLs.
# Set to false to fail clearly instead of falling back to local mock routes.
# Leave unset only if you want unconfigured local development to use mock routes.
PUBLIC_MOCK_API=false

# Server-side credentials for the Netlify function that signs browser uploads
# (/api/upload-url). Read at runtime. The bucket must match the backend's
# S3_BUCKET so POST /api/imports accepts the uploaded object.
#
# Cloudflare R2 (free tier):
#   CUSTOM_AWS_ACCESS_KEY_ID / CUSTOM_AWS_SECRET_ACCESS_KEY = an R2 API token
#   scoped to the bucket, S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com,
#   CUSTOM_AWS_REGION=auto (or leave empty).
# AWS S3: leave S3_ENDPOINT_URL empty and set CUSTOM_AWS_REGION.
CUSTOM_AWS_ACCESS_KEY_ID=
CUSTOM_AWS_SECRET_ACCESS_KEY=
CUSTOM_AWS_REGION=
S3_BUCKET=
S3_ENDPOINT_URL=

# Largest archive the upload helper will sign (bytes). Keep it equal to the
# backend's MAX_IMPORT_ZIP_BYTES. Every signed URL only accepts the declared
# size, so it cannot be reused for a larger file. Default 209715200 (200 MB).
MAX_IMPORT_ZIP_BYTES=
