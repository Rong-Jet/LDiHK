# Backend API origin used by browser calls (/api/ready, /api/me, /api/query,
# /api/population, /api/uploads, /api/imports) and by /api/wake. Read at BUILD
# time: on Netlify set it with the "Builds" scope and redeploy after changing it.
# Example: https://ldihk.onrender.com  (local: http://127.0.0.1:8000)
# Leave empty to use the local Astro mock API routes.
PUBLIC_API_URL=

# Set to true/1/yes/on to force local mock API mode and ignore backend URLs.
# Set to false to fail clearly instead of falling back to local mock routes.
# On Netlify this is set per deploy context in netlify.toml, not in the UI.
PUBLIC_MOCK_API=false

# Mock mode only: largest archive the local mock upload route accepts (bytes).
# In live mode the backend signs uploads (POST /api/uploads) and enforces its
# own MAX_IMPORT_ZIP_BYTES; Netlify needs no storage credentials.
MAX_IMPORT_ZIP_BYTES=
