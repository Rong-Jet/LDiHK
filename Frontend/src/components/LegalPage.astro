---
interface Props {
  heading: string;
  updated: string;
}

const { heading, updated } = Astro.props;
---

<section class="py-16 bg-white text-left">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">{heading}</h1>
    <p class="text-xs text-brand-navy/50 mt-2">Last updated: {updated}</p>
    <div class="legal mt-8 space-y-6 text-sm text-brand-navy/80 leading-relaxed">
      <slot />
    </div>
  </div>
</section>

<style>
  .legal :global(h2) {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-brand-navy);
    margin-top: 2rem;
  }
  .legal :global(h3) {
    font-weight: 700;
    color: var(--color-brand-navy);
    margin-top: 1rem;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li) {
    margin-top: 0.25rem;
  }
  .legal :global(a) {
    color: var(--color-brand-teal);
    text-decoration: underline;
  }
  .legal :global(.placeholder) {
    background: #fff3cd;
    padding: 0 0.25rem;
    border-radius: 0.25rem;
  }
</style>
