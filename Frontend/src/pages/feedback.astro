---
import Layout from '../layouts/Layout.astro';

// The Google Form for bug reports and feature requests. It is only loaded
// after a click: opening it sends the visitor's IP address and cookies to
// Google, which this site otherwise never does (see the privacy policy).
const FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSe-eCsv7rPeinWk7Z69DZF8dJCVJhBCbKlhg0UkByLbrsAkgg/viewform';
---

<Layout title="Feedback | LDiHK">
  <section class="py-16 bg-white text-left">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">Report a bug or request a feature</h1>
      <p class="text-sm text-brand-navy/70 mt-3 leading-relaxed">
        Something broken, confusing or missing? Tell us through the form below. Screenshots help a lot. Please never
        include your LDiHK-ID or your data export in a report.
      </p>

      <div id="feedback-consent" class="mt-8 rounded-3xl border border-brand-navy/10 bg-brand-beige/40 p-6 sm:p-8 text-center space-y-4">
        <p class="text-xs text-brand-navy/70 leading-relaxed max-w-lg mx-auto">
          The form is hosted by Google Forms. When you load it, your browser connects to Google, which receives your IP
          address and may set cookies; Google may ask you to sign in. See our
          <a href="/privacy#feedback" class="text-brand-teal underline">Privacy Policy</a>.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button
            type="button"
            id="feedback-load"
            class="px-5 py-2.5 rounded-xl bg-brand-teal text-white font-bold text-sm cursor-pointer hover:bg-brand-teal/95 shadow-md shadow-brand-teal/15"
          >
            Load the form here
          </button>
          <a
            href={FORM_URL}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl border border-brand-navy/15 bg-white text-brand-navy font-bold text-sm hover:border-brand-navy/30"
          >
            Open in a new tab
          </a>
        </div>
      </div>

      <div id="feedback-frame" class="hidden mt-8 space-y-3">
        <div class="rounded-3xl border border-brand-navy/10 overflow-hidden bg-white shadow-sm">
          <iframe
            data-src={`${FORM_URL}?embedded=true`}
            title="Bug reports and feature requests"
            class="w-full block"
            style="height: 1600px; border: 0;"
            loading="lazy"
          >Loading…</iframe>
        </div>
        <p class="text-xs text-brand-navy/60 text-center">
          Form not showing, or stuck at a sign-in? Some browsers block Google's sign-in inside other sites.
          <a href={FORM_URL} target="_blank" rel="noopener" class="text-brand-teal underline">Open it in a new tab</a> instead.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const consent = document.getElementById('feedback-consent');
  const frameBox = document.getElementById('feedback-frame');
  document.getElementById('feedback-load')?.addEventListener('click', () => {
    const iframe = frameBox?.querySelector('iframe');
    if (!iframe || !frameBox) return;
    iframe.src = iframe.dataset.src ?? '';
    consent?.classList.add('hidden');
    frameBox.classList.remove('hidden');
  });
</script>
