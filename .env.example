# Web bind port for local/container runs. Render injects PORT automatically for
# web services.
PORT=8000

# Hosted Postgres database used by the API, workers, and migrations.
# Neon (free): copy the pooled connection string from the Neon console, e.g.
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database

# Connection and per-statement timeouts. A sleeping free database wakes on the
# first connection; these stop a dead database from hanging requests.
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=60000

# Optional local/live Postgres database used by schema integration tests.
TEST_DATABASE_URL=

# Comma-separated browser origins allowed to call the backend API.
# Example: https://ldihk.xyz,http://localhost:4321
FRONTEND_ALLOWED_ORIGINS=
# Localhost dev origins (ports 3000, 4321, 5173) are allowed unless this is
# false. Set it to false in production.
ALLOW_LOCALHOST_ORIGINS=true

# In-memory rate limits (single web process). Per-ID and global limits always
# apply. Per-IP limits only apply when CLIENT_IP_HEADER names a header the
# proxy sets reliably; Render appends to a client-supplied X-Forwarded-For, so
# that header is not trusted. Check which header carries your IP after
# deploying (e.g. True-Client-IP or CF-Connecting-IP) before setting it.
RATE_LIMITS_ENABLED=true
CLIENT_IP_HEADER=

# Unauthenticated routes that read local processed files (v1-v3 local
# pipeline). Set to false on hosted deployments.
ENABLE_LOCAL_FILE_ROUTES=true

# Enabled for the v5 demo so top-channel/top-video dashboard views can query
# channel_id and video_id dimensions.
ALLOW_IDENTIFIER_DIMENSIONS=true

# Default timezone for date/hour query buckets when a request does not send
# options.timezone. Any IANA name, e.g. UTC or Europe/Berlin.
QUERY_BUCKET_TIMEZONE=UTC

# Run the import and enrichment workers as threads inside the web process
# (free hosting: one service, no paid background workers). They only poll the
# database for WORKER_ACTIVE_WINDOW_SECONDS after the last API request, so a
# free Neon database can still scale to zero.
RUN_WORKERS_IN_PROCESS=false
# Each extra minute keeps a free Neon database awake longer (100 CU-hours a
# month); 120 s is enough because import status polling keeps it active.
WORKER_ACTIVE_WINDOW_SECONDS=120
WORKER_POLL_INTERVAL_SECONDS=30

# Upload storage: any S3-compatible bucket where clients upload ZIP files under
# uploads/<LDiHKID>/<filename>.zip.
# Cloudflare R2: S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# and AWS_REGION=auto. Leave S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. Leave empty for long-lived IAM access keys; set only for temporary
# AWS STS credentials.
AWS_SESSION_TOKEN=
AWS_REGION=

# Maximum ZIP object size accepted by the import worker (200 MiB), and the
# maximum uncompressed size of one history file inside it (150 MiB). Keep
# these low on a 512 MB instance.
MAX_IMPORT_ZIP_BYTES=209715200
MAX_IMPORT_MEMBER_BYTES=157286400

# Job leases: a running job whose heartbeat is older than this is reclaimed,
# and an import is failed after this many attempts.
IMPORT_STALE_AFTER_SECONDS=600
IMPORT_MAX_ATTEMPTS=3

# Standalone import worker polling interval when no queued import is available.
IMPORT_WORKER_POLL_INTERVAL_SECONDS=5

# YouTube Data API key used by duration enrichment workers.
YOUTUBE_API_KEY=

# Duration enrichment worker controls.
YOUTUBE_MAX_DURATION_SECONDS=5400
ENRICHMENT_BATCH_SIZE=50
ENRICHMENT_POLL_INTERVAL_SECONDS=30
ENRICHMENT_RETRY_BASE_SECONDS=300

# Gunicorn (Docker image). One process with threads fits a 512 MB instance.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Runtime logging.
LOG_LEVEL=INFO

# Hosted end-to-end smoke test controls.
BACKEND_BASE_URL=
SMOKE_LDIHK_ID=
SMOKE_WRONG_LDIHK_ID=
SMOKE_S3_KEY=
SMOKE_EXPECTED_EVENT_COUNT=1
SMOKE_EXPECTED_WATCH_COUNT=1
SMOKE_IMPORT_TIMEOUT_SECONDS=180
SMOKE_ENRICHMENT_TIMEOUT_SECONDS=240
SMOKE_POLL_INTERVAL_SECONDS=5
SMOKE_HTTP_TIMEOUT_SECONDS=30
